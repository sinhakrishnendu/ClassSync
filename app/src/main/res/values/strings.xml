    <string name="about_title">About ClassSync</string>
    <string name="about_body">ClassSync is a free, open-source, offline timetable for teachers and academic administration. Version 0.1.0. No advertisements, accounts, subscriptions or analytics.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">ClassSync stores timetable data and preferences locally on your device. It does not collect analytics, track activity, show advertisements, or send timetable information to a server. Notification permission is used only for class reminders. You can export, import, or delete your local data from Settings.</string>
